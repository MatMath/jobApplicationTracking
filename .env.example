# Local Postgres (docker compose up -d). Swap for the Supabase pooler URL in prod.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobtracker

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Development only: bypass OAuth with a stub session for this user id.
# Ignored unless NODE_ENV=development. Mirrors the old app's `USER=... npm run start-dev`.
DEV_USER_ID=
