# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
# Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key: safe in the browser, subject to RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key: BYPASSES RLS. Server-only, never import into a client component.
SUPABASE_SECRET_KEY=

# Direct Postgres connection, for Drizzle migrations and dashboard aggregation.
# Settings -> Database -> Connection string -> URI (session pooler, port 5432).
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=

# Public origin Google is sent back to. Falls back to request headers when unset,
# which is fine locally but wrong behind a proxy - set it explicitly in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Logo.dev publishable key. Safe client-side; renders company logos by domain.
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Google Maps Platform key. Server-side only, never NEXT_PUBLIC_: it backs the
# office address suggestions and the dashboard map, both of which are proxied
# through this app so the key stays out of the browser. Needs "Places API (New)"
# and "Maps Static API" enabled. Optional - without it addresses still save,
# they just get no map pin. See README "Office locations and the map".
GOOGLE_MAPS_API_KEY=

# Maps JavaScript API key, for the interactive dashboard map. Browser-visible by
# design - restrict it to the Maps JavaScript API and to your own domains, and
# keep it separate from GOOGLE_MAPS_API_KEY above, which can spend Places quota.
# Optional: without it the map falls back to a still image.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
